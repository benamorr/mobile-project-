<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- Top Header Bar with Brand-New IRONFIT Logo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingTop="18dp"
                android:paddingBottom="12dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/iv_home_brand_logo"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/ic_ironfit_logo"
                    android:contentDescription="IronFit Logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IRONFIT"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12"
                        android:fontFamily="sans-serif-black" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="PRO"
                        android:textColor="@color/color_accent"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:background="@drawable/bg_chip" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_notification"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_timer"
                    android:padding="4dp"
                    android:background="@drawable/bg_chip"
                    android:tint="#CCCCCC"
                    android:contentDescription="Notifications" />
            </LinearLayout>

            <!-- Greeting Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="#1A1B20"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="#282A32"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome Back,"
                        android:textColor="#8E92A0"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Athlete"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="12dp"
                        android:text="Ready for peak performance today?"
                        android:textColor="#8E92A0"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tv_user_weight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="75.0 kg"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:id="@+id/tv_goal_chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Muscle Gain"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:background="@drawable/bg_chip_selected" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 1. TODAY'S WORKOUT HERO CARD (PROMINENT AT TOP) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="#1F1F22"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeColor="#323238"
                app:strokeWidth="1dp"
                android:stateListAnimator="@animator/card_press_animator"
                android:foreground="?attr/selectableItemBackground">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Background Hero Image -->
                    <ImageView
                        android:id="@+id/iv_workout_hero"
                        android:layout_width="match_parent"
                        android:layout_height="210dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_home_hero"
                        android:contentDescription="Today's Workout" />

                    <!-- Dark Gradient Overlay for readability -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="210dp"
                        android:background="@drawable/bg_image_overlay_gradient" />

                    <!-- Red left border stripe -->
                    <View
                        android:layout_width="4dp"
                        android:layout_height="match_parent"
                        android:background="#E53935" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TODAY&#39;S WORKOUT"
                            android:textColor="#E53935"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1" />

                        <TextView
                            android:id="@+id/tv_workout_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Push Day - Chest &amp; Shoulders"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="12dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_exercise"
                                android:tint="#FFFFFF"
                                android:contentDescription="Exercises" />

                            <TextView
                                android:id="@+id/tv_exercise_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:layout_marginEnd="16dp"
                                android:text="6 exercises"
                                android:textColor="#E0E0E0"
                                android:textSize="13sp" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_timer"
                                android:tint="#FFFFFF"
                                android:contentDescription="Duration" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="~45 min"
                                android:textColor="#E0E0E0"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/progress_workout"
                            style="@android:style/Widget.Material.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:progress="40"
                            android:progressTint="#E53935"
                            android:progressBackgroundTint="#555555" />

                        <TextView
                            android:id="@+id/tv_completion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="40% Complete"
                            android:textColor="#E0E0E0"
                            android:textSize="12sp" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. WEEKLY ACTIVITY SECTION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:text="WEEKLY ACTIVITY"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <LinearLayout
                android:id="@+id/ll_weekly_bars"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="18dp"
                android:weightSum="7">

                <!-- Mon -->
                <LinearLayout android:layout_width="0dp" android:layout_height="75dp"
                    android:layout_weight="1" android:orientation="vertical"
                    android:gravity="bottom|center_horizontal">
                    <View android:id="@+id/bar_mon" android:layout_width="8dp" android:layout_height="20dp"
                        android:background="#E53935" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="M" android:textColor="#A0A0A0" android:textSize="10sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Tue -->
                <LinearLayout android:layout_width="0dp" android:layout_height="75dp"
                    android:layout_weight="1" android:orientation="vertical"
                    android:gravity="bottom|center_horizontal">
                    <View android:id="@+id/bar_tue" android:layout_width="8dp" android:layout_height="45dp"
                        android:background="#E53935" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="T" android:textColor="#A0A0A0" android:textSize="10sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Wed -->
                <LinearLayout android:layout_width="0dp" android:layout_height="75dp"
                    android:layout_weight="1" android:orientation="vertical"
                    android:gravity="bottom|center_horizontal">
                    <View android:id="@+id/bar_wed" android:layout_width="8dp" android:layout_height="10dp"
                        android:background="#333333" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="W" android:textColor="#A0A0A0" android:textSize="10sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Thu -->
                <LinearLayout android:layout_width="0dp" android:layout_height="75dp"
                    android:layout_weight="1" android:orientation="vertical"
                    android:gravity="bottom|center_horizontal">
                    <View android:id="@+id/bar_thu" android:layout_width="8dp" android:layout_height="55dp"
                        android:background="#E53935" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="T" android:textColor="#A0A0A0" android:textSize="10sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Fri -->
                <LinearLayout android:layout_width="0dp" android:layout_height="75dp"
                    android:layout_weight="1" android:orientation="vertical"
                    android:gravity="bottom|center_horizontal">
                    <View android:id="@+id/bar_fri" android:layout_width="8dp" android:layout_height="40dp"
                        android:background="#E53935" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="F" android:textColor="#A0A0A0" android:textSize="10sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Sat -->
                <LinearLayout android:layout_width="0dp" android:layout_height="75dp"
                    android:layout_weight="1" android:orientation="vertical"
                    android:gravity="bottom|center_horizontal">
                    <View android:id="@+id/bar_sat" android:layout_width="8dp" android:layout_height="10dp"
                        android:background="#333333" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="S" android:textColor="#A0A0A0" android:textSize="10sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Sun -->
                <LinearLayout android:layout_width="0dp" android:layout_height="75dp"
                    android:layout_weight="1" android:orientation="vertical"
                    android:gravity="bottom|center_horizontal">
                    <View android:id="@+id/bar_sun" android:layout_width="8dp" android:layout_height="10dp"
                        android:background="#333333" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="S" android:textColor="#A0A0A0" android:textSize="10sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 4. EXERCISE CATEGORIES SECTION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp"
                android:text="EXERCISE CATEGORIES"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:scrollbars="none"
                android:paddingHorizontal="16dp">

                <LinearLayout
                    android:id="@+id/ll_categories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView android:layout_width="wrap_content" android:layout_height="36dp"
                        android:text="Chest" android:textColor="#FFFFFF" android:textSize="13sp"
                        android:gravity="center" android:paddingHorizontal="16dp"
                        android:layout_marginEnd="8dp" android:background="@drawable/bg_chip_selected"
                        android:id="@+id/chip_chest" />
                    <TextView android:layout_width="wrap_content" android:layout_height="36dp"
                        android:text="Back" android:textColor="#FFFFFF" android:textSize="13sp"
                        android:gravity="center" android:paddingHorizontal="16dp"
                        android:layout_marginEnd="8dp" android:background="@drawable/bg_chip"
                        android:id="@+id/chip_back" />
                    <TextView android:layout_width="wrap_content" android:layout_height="36dp"
                        android:text="Shoulders" android:textColor="#FFFFFF" android:textSize="13sp"
                        android:gravity="center" android:paddingHorizontal="16dp"
                        android:layout_marginEnd="8dp" android:background="@drawable/bg_chip"
                        android:id="@+id/chip_shoulders" />
                    <TextView android:layout_width="wrap_content" android:layout_height="36dp"
                        android:text="Biceps" android:textColor="#FFFFFF" android:textSize="13sp"
                        android:gravity="center" android:paddingHorizontal="16dp"
                        android:layout_marginEnd="8dp" android:background="@drawable/bg_chip"
                        android:id="@+id/chip_biceps" />
                    <TextView android:layout_width="wrap_content" android:layout_height="36dp"
                        android:text="Triceps" android:textColor="#FFFFFF" android:textSize="13sp"
                        android:gravity="center" android:paddingHorizontal="16dp"
                        android:layout_marginEnd="8dp" android:background="@drawable/bg_chip"
                        android:id="@+id/chip_triceps" />
                    <TextView android:layout_width="wrap_content" android:layout_height="36dp"
                        android:text="Legs" android:textColor="#FFFFFF" android:textSize="13sp"
                        android:gravity="center" android:paddingHorizontal="16dp"
                        android:layout_marginEnd="8dp" android:background="@drawable/bg_chip"
                        android:id="@+id/chip_legs" />
                    <TextView android:layout_width="wrap_content" android:layout_height="36dp"
                        android:text="Abs" android:textColor="#FFFFFF" android:textSize="13sp"
                        android:gravity="center" android:paddingHorizontal="16dp"
                        android:background="@drawable/bg_chip"
                        android:id="@+id/chip_abs" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- 5. START WORKOUT BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_start_workout"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginHorizontal="16dp"
                android:text="START WORKOUT"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                app:backgroundTint="@null"
                android:background="@drawable/bg_button_gradient_modern"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_dumbbell"
                app:iconTint="#FFFFFF"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                android:stateListAnimator="@animator/button_press_animator" />

        </LinearLayout>
</androidx.core.widget.NestedScrollView>
