<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Session Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:background="@color/color_surface"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btn_close_session"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_chip"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/white"
                android:contentDescription="Cancel Workout" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_session_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active Workout Session"
                    android:textColor="@color/color_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Track every set &amp; rep"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Stopwatch Timer -->
            <TextView
                android:id="@+id/tv_session_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textColor="@color/color_accent"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Rest Timer Banner (collapsible) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_rest_timer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:cardBackgroundColor="@color/color_accent_dark"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_timer"
                    app:tint="@color/white"
                    android:contentDescription="Rest" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REST INTERVAL"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:id="@+id/tv_rest_countdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="60s remaining"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_skip_rest"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="SKIP"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:backgroundTint="#33000000"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Exercises List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_session_exercises"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingVertical="8dp"
            android:clipToPadding="false" />

        <!-- Bottom Finish Workout Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/color_surface"
            android:padding="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_finish_workout"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="FINISH WORKOUT"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                app:backgroundTint="@null"
                android:background="@drawable/bg_button_gradient_modern"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_check"
                app:iconTint="@color/white"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                android:stateListAnimator="@animator/button_press_animator" />
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
